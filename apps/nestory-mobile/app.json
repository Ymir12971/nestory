{
  "expo": {
    "name": "Nestory",
    "slug": "nestory",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "nestory",
    "newArchEnabled": true,
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FEFCFA"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.blakard.nestory",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.blakard.nestory",
      "versionCode": 12,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/splash-icon.png",
        "backgroundColor": "#FBF6EC"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Nestory accesses your photos so you can add them to your child's memories.",
          "cameraPermission": "Nestory uses your camera so you can take a photo to add to your child's memories."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35
          }
        }
      ],
      "expo-localization",
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "14a340fa-15e4-438d-ae66-75a366a1f510"
      }
    }
  }
}
