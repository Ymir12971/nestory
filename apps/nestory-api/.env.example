NODE_ENV=development
PORT=3001
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:8081

# ─────────────────────────────────────────────────────────────────────────────
# 这份默认值就是本地开发环境，`cp .env.example .env` 之后不用改任何一行。
# 起服务：`pnpm dev`（会先把 Docker 里的本地栈拉起来、跑迁移、灌种子数据）。
#
# 线上 prod 的值在 Railway → Variables，跟这个文件无关。
# ─────────────────────────────────────────────────────────────────────────────

# Supabase — 本地栈（`npx supabase start`，容器跑在 Docker 里）
# DB 54322 / 网关 54321 / Studio 54323。下面这个 service_role key 是 Supabase
# 本地栈的固定公开 demo key，每个人 `supabase start` 出来的都一样，不是密钥。
# Prod(Railway)：DATABASE_URL 走 pooler(6543)拿 IPv4 + 抗连接抖动，
#   DIRECT_URL 保留直连(5432)给 `prisma migrate deploy`。
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# 本地不需要真 OAuth：`Bearer dev-<userId>` 在 NODE_ENV !== production 时直接
# 放行（src/lib/auth.ts），mobile 的 _devUserId 默认就是 seed 出来的那个用户。

# Redis (BullMQ)
# 6380 是 nestory 专用容器（redis:7-alpine）。本机 6379 被一个无关的 Windows
# 原生 Redis 3.2 服务占着，BullMQ 要 ≥5，不收。`pnpm dev` 会自动建/启这个容器：
#   docker run -d --name nestory-redis \
#     --label com.docker.compose.project=Nestory \
#     --label com.docker.compose.service=redis \
#     -p 6380:6379 redis:7-alpine
# 两个 label 只为在 Docker Desktop 里跟 supabase 那堆归到同一组显示。
REDIS_URL=redis://localhost:6380

# Anthropic —— 本地留空，靠 STORY_AI_MOCK 走确定性 mock 生成器（秒回、不烧钱）。
# 要在本地跑真实生成再填 key 并把 STORY_AI_MOCK 改成 0。
ANTHROPIC_API_KEY=
# 1-mock, 0-real —— 注释不能写在行尾，Node 的 --env-file 会把它读进值里
STORY_AI_MOCK=1

# OpenAI
OPENAI_API_KEY=sk-...

# RevenueCat
REVENUECAT_WEBHOOK_SECRET=...

# 事务邮件（Resend）—— 本地留空即可：没有 key 就一封都不发，只在日志里留一行，
# 其余行为跟没接之前完全一样。填了才会真发。
#
# 发信域名是子域名 mail.blakard.com（记录加在子域名上，根域名的 Google Workspace
# MX 和 GoDaddy 托管的 SPF 一个字都不用动）。域名要先在 Resend 后台验证通过。
RESEND_API_KEY=
MAIL_FROM=Nestory <noreply@mail.blakard.com>
# 用户反馈的通知收件箱。留空 = 反馈照样落库，只是不发通知信。
FEEDBACK_NOTIFY_TO=general@blakard.com
